# Schedules mirror the production CronJobs (infra charts/web-ui cronjobs.yaml)
# so behaviour matches what webtor.io runs. Every entry goes through
# run-cron-job, which sources the service environment and skips jobs whose
# optional configuration is absent.

# Subscriptions carry their own next_check_at; this is the resolution of the
# poller, not how often any one subscription is checked.
17 * * * * /etc/s6-overlay/scripts/run-cron-job subscription-poll subscription poll
0 0 * * * /etc/s6-overlay/scripts/run-cron-job cache-index-cleanup cache-index cleanup
0 */6 * * * /etc/s6-overlay/scripts/run-cron-job enrich-popular enrich popular
0 9 * * * /etc/s6-overlay/scripts/run-cron-job notification-send notification send

# Mirrors the production CronJobs. reap is web-ui's own subcommand and expires
# pledges against web-ui's tables; gc is vault's and sweeps files that no
# resource_file row references. Both skip when USE_VAULT=false.
0 * * * * /etc/s6-overlay/scripts/run-cron-job vault-reap vault reap
0 4 * * * /etc/s6-overlay/scripts/run-cron-job vault-gc-unused vault gc
