USE_PPROF=false
USE_PROBE=false
USE_PROM=false
DATA_DIR=${DATA_DIR:-/data}
STORAGE_DIR=${STORAGE_DIR:-/storage}
S3_SERVICE_HOST=127.0.0.1
S3_SERVICE_PORT=8099
USE_LOCALS3=${USE_LOCALS3:-true}
AWS_ENDPOINT=${AWS_ENDPOINT:-http://127.0.0.1:8099}
AWS_REGION=${AWS_REGION:-us-east-1}
AWS_NO_SSL=${AWS_NO_SSL:-true}
AWS_POSTER_CACHE_BUCKET=${AWS_POSTER_CACHE_BUCKET:-posters}
AWS_USER_SUBTITLE_BUCKET=${AWS_USER_SUBTITLE_BUCKET:-subtitles}
AWS_THUMBNAIL_BUCKET=${AWS_THUMBNAIL_BUCKET:-thumbnails}
TORRENT_STORE_SERVICE_PORT=50051
TORRENT_STORE_SERVICE_HOST=127.0.0.1
MAGNET2TORRENT_SERVICE_PORT=50052
MAGNET2TORRENT_SERVICE_HOST=127.0.0.1
EXTERNAL_PROXY_SERVICE_PORT=8090
EXTERNAL_PROXY_SERVICE_HOST=127.0.0.1
REDIS_MASTER_SERVICE_PORT=6379
REDIS_MASTER_SERVICE_HOST=127.0.0.1
TORRENT_WEB_SEEDER_SERVICE_PORT=8091
TORRENT_WEB_SEEDER_SERVICE_HOST=127.0.0.1
CONTENT_TRANSCODER_SERVICE_PORT=8092
CONTENT_TRANSCODER_SERVICE_HOST=127.0.0.1
TORRENT_ARCHIVER_SERVICE_PORT=8093
TORRENT_ARCHIVER_SERVICE_HOST=127.0.0.1
SRT2VTT_SERVICE_PORT=8094
SRT2VTT_SERVICE_HOST=127.0.0.1
TORRENT_HTTP_PROXY_SERVICE_PORT=8095
TORRENT_HTTP_PROXY_SERVICE_HOST=127.0.0.1
REST_API_SERVICE_PORT=8096
REST_API_SERVICE_HOST=127.0.0.1
WEB_UI_SERVICE_PORT=8097
WEB_UI_SERVICE_HOST=127.0.0.1
NGINX_VOD_SERVICE_PORT=8098
NGINX_VOD_SERVICE_HOST=127.0.0.1
NATS_SERVICE_HOST=127.0.0.1
NATS_SERVICE_PORT=4222
WEB_PORT=8080
USE_INTERNAL_TORRENT_HTTP_PROXY=true
USE_LOCALPG=${USE_LOCALPG:-true}
PGDATA_DIR=${PGDATA_DIR:-/pgdata}
PG_USER=${PG_USER:-app}
PG_PASSWORD=${PG_PASSWORD:-app}
PG_DATABASE=${PG_DATABASE:-app}
PG_HOST=${PG_HOST:-localhost}
PG_PORT=${PG_PORT:-5432}
VAULT_PG_DATABASE=${VAULT_PG_DATABASE:-vault}
USE_VAULT=${USE_VAULT:-true}
VAULT_SERVICE_HOST=127.0.0.1
VAULT_SERVICE_PORT=8100
VAULT_AWS_BUCKET=${VAULT_AWS_BUCKET:-vault}
GIN_MODE=release
DOMAIN=${DOMAIN:-http://localhost:8080}
ADMIN_PASSWORD=${ADMIN_PASSWORD:-}
ONLY_AUTHORIZED=${ONLY_AUTHORIZED:-true}
# Paired with the line above. /embed is exempt from the gate on purpose: a
# third-party iframe has no session here, so redirecting it to a login form
# would just render a broken player. Access is decided by the embed domain
# list on the profile page instead, and this is the flag that turns that list
# from "these domains see no ads" into "only these domains may embed".
EMBED_ONLY_AUTHORIZED=${EMBED_ONLY_AUTHORIZED:-true}
STREMIO_ADDON_USER_AGENT=${STREMIO_ADDON_USER_AGENT:-Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/80.0.3987.149 Safari/537.36}
# Scheduled jobs (subscription polling, cache-index cleanup, metadata
# enrichment, notification mail). Set to true on extra instances that share
# one database, so only one of them runs them.
DISABLE_CRON=${DISABLE_CRON:-false}
