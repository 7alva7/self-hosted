#!/command/with-contenv sh

# Mirrors generate-api-key-and-secret: web-ui signs session cookies and CSRF
# tokens with SESSION_SECRET (services/common/common.go), which defaults to
# the literal "secret123" published in web-ui's source. Self-hosted only gets
# away with that default because it always runs with the Redis session store,
# which keeps session contents server-side -- but nothing stops an instance
# from being pointed at the cookie store instead, and a known secret there
# lets anyone mint an admin-authenticated cookie without the password. So
# generate a real one on first start and persist it, the same way the API
# key/secret pair already is.

log() {
   echo "$1" | s6-log p"[generate-session-secret]" 1
}

# Values are written single-quoted: this file is re-read with `source` as
# root, so a bare value containing $(...), a backtick, a space or an
# apostrophe would execute, break the file, or silently arrive different
# from what the operator set.
shquote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

f=/etc/webtor/secrets/session.env
mkdir -p "$(dirname "$f")"
if [ -n "$SESSION_SECRET" ]; then
  log "using provided SESSION_SECRET"
  secret=$SESSION_SECRET
elif [ -f $f ]; then
  log "secret file ${f} already exists"
  exit
else
  log "generating SESSION_SECRET"
  secret=$(uuidgen | sha1sum | head -c 40)
fi
log "storing SESSION_SECRET to ${f}"
umask 077
printf 'SESSION_SECRET=%s\n' "$(shquote "$secret")" > "$f"
chmod 600 "$f"
