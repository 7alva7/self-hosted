#!/command/with-contenv sh

log() {
   echo "$1" | s6-log p"[generate-s3-credentials]" 1
}

# Values are written single-quoted, because this file is re-read with `source`
# by both s3/run and web-ui/run -- as root. Written bare, an operator secret
# containing $(...) or a backtick executes on every boot, one containing a
# space or an apostrophe makes the file a syntax error, and either way the
# value the services end up with is not the one the operator set. That
# presents as SignatureDoesNotMatch against a store that looks healthy.
# README invites bring-your-own credentials and S3 secrets are not restricted
# to hex, so this is reachable without doing anything unusual.
shquote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

f=/etc/webtor/secrets/s3.env
mkdir -p "$(dirname "$f")"
if [ -n "$AWS_ACCESS_KEY_ID" ] && [ -n "$AWS_SECRET_ACCESS_KEY" ]; then
  log "using provided AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY"
  key=$AWS_ACCESS_KEY_ID
  secret=$AWS_SECRET_ACCESS_KEY
elif [ -n "$AWS_ACCESS_KEY_ID" ] || [ -n "$AWS_SECRET_ACCESS_KEY" ]; then
  # Say so rather than quietly generating a pair. Supplying one of the two is
  # a typo in a variable name far more often than it is a deliberate choice,
  # and the silent path hands back a working built-in store on credentials the
  # operator never chose -- which looks like success until their own client,
  # or their external S3, refuses them.
  log "WARNING: only one of AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY is set."
  log "Both are required to use your own credentials; check the name of the other."
  log "Falling back to generated credentials for the built-in store."
  key=
  secret=
fi

if [ -z "$key" ]; then
  if [ -f "$f" ]; then
    log "credentials file ${f} already exists"
    exit
  fi
  log "generating S3 credentials"
  key=$(uuidgen | tr -d '-' | head -c 20)
  secret=$(uuidgen | sha1sum | head -c 40)
fi

log "storing S3 credentials to ${f}"
umask 077
{
  printf 'AWS_ACCESS_KEY_ID=%s\n' "$(shquote "$key")"
  printf 'AWS_SECRET_ACCESS_KEY=%s\n' "$(shquote "$secret")"
} > "$f"
chmod 600 "$f"
