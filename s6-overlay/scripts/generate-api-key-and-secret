#!/command/with-contenv sh

log() {
   echo "$1" | s6-log p"[generate-api-key-and-secret]" 1
}

# Values are written single-quoted: this file is re-read with `source` as
# root, so a bare value containing $(...), a backtick, a space or an
# apostrophe would execute, break the file, or silently arrive different
# from what the operator set.
shquote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

f=/etc/webtor/secrets/api.env
mkdir -p "$(dirname "$f")"
if [ -n "$API_KEY" ] && [ -n "$API_SECRET" ]; then
  log "using provided API_KEY and API_SECRET"
  key=$API_KEY
  secret=$API_SECRET
elif [ -f $f ]; then
  log "key file ${f} already exists"
  exit
else
  log "generating API_KEY and API_SECRET"
  key=$(uuidgen | tr '[:upper:]' '[:lower:]')
  secret=$(uuidgen | sha1sum | head -c 40)
fi
log "storing API_KEY and API_SECRET to ${f}"
umask 077
{
  printf 'API_KEY=%s\n' "$(shquote "$key")"
  printf 'API_SECRET=%s\n' "$(shquote "$secret")"
} > "$f"
chmod 600 "$f"
