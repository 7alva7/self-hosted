#!/command/with-contenv sh
set -a
source /etc/webtor/common.env
source /etc/webtor/secrets/s3.env
set +a

log() {
  echo "$1" | s6-log p"[s3]" 1
}

if [ "${USE_LOCALS3:-true}" = "false" ]; then
  log "USE_LOCALS3=false -- not starting the built-in S3; set AWS_ENDPOINT to your own"
  # s6 restarts a longrun that exits, so idle rather than exiting.
  exec sleep infinity
fi

mkdir -p "$STORAGE_DIR" 2>/dev/null

# versitygw's posix backend keeps object metadata -- etag, content type,
# checksums, multipart state -- in extended attributes, and exits if the
# filesystem cannot store them. That is the case for a bind mount from macOS
# or Windows, and for some network filesystems on Linux. Say so plainly here
# instead of crash-looping with "xattr check failed" every second.
#
# Writability is checked on its own, before the xattr probe. Both failures
# make `setfattr` fail, so folding them together would report "no extended
# attribute support" for what is really a permissions or read-only-mount
# problem -- sending the operator to change volume type when they need to
# fix ownership. The two need different fixes, so they get different messages.
probe="$STORAGE_DIR/.xattr-probe"
# touch, not `: > "$probe"`: `:` is a POSIX special builtin, and a redirection
# error on one is allowed to terminate the shell outright rather than yield a
# non-zero status the `if` can catch. touch is a regular command with plain
# exit-status semantics, so the failure is actually testable here.
if ! touch "$probe" 2>/dev/null; then
  log "FATAL: $STORAGE_DIR is not writable, so the S3 store cannot run."
  log "Check the ownership and mount options of the volume mounted there"
  log "(a read-only mount, or one owned by another uid, produces this),"
  log "or set USE_LOCALS3=false and point AWS_ENDPOINT at an external S3."
  exec sleep infinity
fi
if ! setfattr -n user.webtor -v probe "$probe" 2>/dev/null; then
  rm -f "$probe"
  log "FATAL: $STORAGE_DIR does not support extended attributes, which the S3 store requires."
  log "Mount it as a named docker volume (-v storage:/storage) rather than a host directory,"
  log "or set USE_LOCALS3=false and point AWS_ENDPOINT at an external S3."
  exec sleep infinity
fi
rm -f "$probe"

# A bucket is just a directory in the storage root -- versitygw's posix
# backend returns whatever exists here from ListBuckets. Created here,
# after the writability/xattr probes above have already established that
# $STORAGE_DIR is usable, so a bad volume fails with the FATAL messages
# above instead of a bare mkdir error from a separate oneshot that s6-rc
# would then refuse to start s3 over.
for b in vault posters subtitles thumbnails; do
  mkdir -p "$STORAGE_DIR/$b"
done

exec /app/versitygw \
  --port "$S3_SERVICE_HOST:$S3_SERVICE_PORT" \
  --access "$AWS_ACCESS_KEY_ID" \
  --secret "$AWS_SECRET_ACCESS_KEY" \
  posix "$STORAGE_DIR" 2>&1 | s6-log p"[s3]" 1
